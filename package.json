{
  "name": "bet-verse",
  "version": "1.0.0",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "render:build": "npm ci --include=dev --ignore-scripts && npm --prefix server ci --omit=dev --ignore-scripts && npm run build",
    "render:start": "node scripts/start-render.mjs",
    "deploy:package": "node scripts/package-deployment.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:open": "cap open android",
    "ng": "ng",
    "start": "node --env-file-if-exists=server/.env server/index.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "ng serve",
    "dev:api": "npm --prefix server run dev",
    "setup": "npm ci && npm --prefix server ci",
    "test:web": "ng test --watch=false",
    "test:api": "npm --prefix server test",
    "check": "npm run test:api && npm run test:web && npm run build",
    "admin": "npm --prefix server run admin",
    "seed:demo": "npm --prefix server run seed:demo",
    "backup": "npm --prefix server run backup",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@capacitor/cli": "8.6.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
