/.local-tools/
**/.gradle/
**/.kotlin/
**/build/
**/local.properties
/.private/
*.jks
*.keystore
*.p12
*.pfx
gha-creds-*.json
*-firebase-adminsdk-*.json
/firebase-service-account.json
