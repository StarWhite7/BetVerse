{
  "name": "betverse-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.mjs",
    "dev": "node --env-file-if-exists=.env --watch index.mjs",
    "test": "node --test test/*.test.mjs",
    "admin": "node --env-file-if-exists=.env cli.mjs admin",
    "seed:demo": "node --env-file-if-exists=.env cli.mjs seed-demo",
    "backup": "node --env-file-if-exists=.env cli.mjs backup"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.0.0"
  }
}
