NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:4200
# DATABASE_PATH defaults to server/.data/betverse.sqlite
# Production: HTTPS origin, persistent absolute DATABASE_PATH, SMTP required.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM=BetVerse <noreply@example.com>
# TRUST_PROXY=1 only behind one trusted reverse proxy, with direct access blocked.
# Temporary admin bootstrap, then remove ADMIN_PASSWORD:
# ADMIN_EMAIL=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=


# The Odds API: imports manuels uniquement. Une clé seule ne déclenche aucun appel.
THE_ODDS_API_MODE=disabled
THE_ODDS_API_DAILY_LIMIT=10
THE_ODDS_API_MONTHLY_LIMIT=400
# THE_ODDS_API_KEY=

# Administrateurs : conserver cette clé hors du dépôt et des sauvegardes publiques.
# ADMIN_MFA_KEY=64_caracteres_hexadecimaux_aleatoires
ADMIN_MFA_REQUIRED=0

# Push : désactivé sans configuration complète ; compte de service dédié FCM,
# distinct du compte GitHub App Distribution. Aucun appel sportif associé.
FCM_ENABLED=0
# FCM_PROJECT_ID=betverse-f89bf
# FCM_SERVICE_ACCOUNT_FILE=/etc/secrets/fcm-service-account.json
# FCM_TOKEN_KEY=64_caracteres_hexadecimaux_aleatoires

# Sauvegardes AES-256-GCM : distant HTTPS PUT + politique de rétention du stockage.
BACKUP_ENABLED=0
# BACKUP_DIRECTORY=/var/data/encrypted-backups
# BACKUP_ENCRYPTION_KEY=64_caracteres_hexadecimaux_aleatoires
# ERASURE_ENCRYPTION_KEY=cle_separee_facultative_pour_le_journal_64_hex
# BACKUP_UPLOAD_BASE=https://stockage-prive.example/betverse/
# BACKUP_UPLOAD_AUTH=Bearer_identifiant_stockage_prive

# Phase de test : studio non immatriculé, documents non finalisés.
LEGAL_READY=0
SUPPORT_VERIFIED=0
MAINTENANCE_MODE=0
# EDITOR_STATUS=
# EDITOR_ADDRESS=
